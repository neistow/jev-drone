# Native TypeSafe Jev key (https://console.typesafe.ai/keys)
TYPESAFE_API_KEY=ts-your-key-here

# OpenRouter key for OpenRouter decision models (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: default model (e.g. jev-latest, ~typesafe/jev-latest, microsoft/microsoft-decision-1)
# JEV_MODEL=jev-latest
# Optional: set USE_OPENROUTER=1 to force jev-latest through OpenRouter instead of native TypeSafe
# USE_OPENROUTER=0
