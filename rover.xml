<mujoco model="chaser_rover">
  <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>
  
  <default>
    <joint limited="false" damping="0.1"/>
    <geom friction="1.5 0.5 0.1" density="1000" margin="0.01"/>
    <!-- velocity actuator defaults -->
    <velocity kv="20" />
  </default>

  <asset>
    <material name="car_body" rgba="0.1 0.4 0.8 1"/>
    <material name="car_cabin" rgba="0.2 0.2 0.2 1"/>
    <material name="car_wheel" rgba="0.1 0.1 0.1 1"/>
    <mesh name="chassis_mesh" scale="0.015 0.012 0.005"
      vertex=" 9   2   0
              -10  10  10
               9  -2   0
               10  3  -10
               10 -3  -10
              -8   10 -10
              -10 -10  10
              -8  -10 -10
              -5   0   20"/>
  </asset>

  <worldbody>
    <body name="chaser" pos="0 0 0.2">
      <freejoint name="chaser_root"/>
      <site name="chaser_root_site" pos="0 0 0"/>
      <!-- Collision Chassis -->
      <geom name="chaser_collision" type="box" size="0.35 0.18 0.05" pos="0 0 0" rgba="0 0 0 0"/>
      
      <!-- Visuals (no collision, no mass) -->
      <geom name="vis_base" type="box" size="0.35 0.18 0.05" pos="0 0 0" material="car_body" contype="0" conaffinity="0" mass="0"/>
      <geom name="vis_cabin" type="box" size="0.15 0.12 0.06" pos="-0.05 0 0.11" material="car_cabin" contype="0" conaffinity="0" mass="0"/>
      <geom name="vis_nose" type="box" size="0.05 0.12 0.03" pos="0.40 0 -0.02" material="car_cabin" contype="0" conaffinity="0" mass="0"/>
      
      <!-- Headlights -->
      <geom name="vis_hl_L" type="cylinder" size="0.02 0.01" pos="0.45 0.08 0.0" euler="0 90 0" rgba="0.9 0.9 0.5 1" contype="0" conaffinity="0" mass="0"/>
      <geom name="vis_hl_R" type="cylinder" size="0.02 0.01" pos="0.45 -0.08 0.0" euler="0 90 0" rgba="0.9 0.9 0.5 1" contype="0" conaffinity="0" mass="0"/>
      
      <!-- Rear Spoiler -->
      <geom name="vis_spoiler_strut_L" type="cylinder" size="0.008 0.04" pos="-0.30 0.12 0.09" material="car_cabin" contype="0" conaffinity="0" mass="0"/>
      <geom name="vis_spoiler_strut_R" type="cylinder" size="0.008 0.04" pos="-0.30 -0.12 0.09" material="car_cabin" contype="0" conaffinity="0" mass="0"/>
      <geom name="vis_spoiler_wing" type="box" size="0.04 0.16 0.01" pos="-0.32 0 0.14" material="car_body" contype="0" conaffinity="0" mass="0"/>
      
      <!-- Camera Mast -->
      <geom name="vis_mast" type="cylinder" size="0.01 0.05" pos="0.30 0 0.08" material="car_cabin" contype="0" conaffinity="0" mass="0"/>
      
      <!-- Forward Camera -->
      <camera name="chaser_camera" pos="0.35 0 0.15" zaxis="1 0 0" fovy="91" resolution="800 600"/>

      <!-- Wheels -->
      <!-- Front Left -->
      <body name="fl_wheel" pos="0.25 0.3 -0.05">
        <joint name="fl_joint" type="hinge" axis="0 1 0"/>
        <geom name="fl_geom" type="cylinder" size="0.12 0.04" euler="90 0 0" material="car_wheel"/>
      </body>
      <!-- Back Left -->
      <body name="bl_wheel" pos="-0.25 0.3 -0.05">
        <joint name="bl_joint" type="hinge" axis="0 1 0"/>
        <geom name="bl_geom" type="cylinder" size="0.12 0.04" euler="90 0 0" material="car_wheel"/>
      </body>
      <!-- Front Right -->
      <body name="fr_wheel" pos="0.25 -0.3 -0.05">
        <joint name="fr_joint" type="hinge" axis="0 1 0"/>
        <geom name="fr_geom" type="cylinder" size="0.12 0.04" euler="90 0 0" material="car_wheel"/>
      </body>
      <!-- Back Right -->
      <body name="br_wheel" pos="-0.25 -0.3 -0.05">
        <joint name="br_joint" type="hinge" axis="0 1 0"/>
        <geom name="br_geom" type="cylinder" size="0.12 0.04" euler="90 0 0" material="car_wheel"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <velocity name="drive_fl" joint="fl_joint"/>
    <velocity name="drive_bl" joint="bl_joint"/>
    <velocity name="drive_fr" joint="fr_joint"/>
    <velocity name="drive_br" joint="br_joint"/>
  </actuator>
</mujoco>
