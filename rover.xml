<mujoco model="chaser_rover">
  <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>
  
  <default>
    <joint limited="false" damping="0.1"/>
    <geom friction="1.5 0.5 0.1" density="1000" margin="0.01"/>
    <!-- velocity actuator defaults -->
    <velocity kv="20" />
  </default>

  <asset>
    <material name="car_body" rgba="0.1 0.4 0.8 1"/>
    <material name="car_cabin" rgba="0.2 0.2 0.2 1"/>
    <material name="car_wheel" rgba="0.1 0.1 0.1 1"/>
    <mesh name="chassis_mesh" scale="0.015 0.012 0.005"
      vertex=" 9   2   0
              -10  10  10
               9  -2   0
               10  3  -10
               10 -3  -10
              -8   10 -10
              -10 -10  10
              -8  -10 -10
              -5   0   20"/>
  </asset>

  <worldbody>
    <body name="chaser" pos="0 0 0.2">
      <freejoint name="chaser_root"/>
      <site name="chaser_root_site" pos="0 0 0"/>
      <!-- Chassis -->
      <geom name="chaser_chassis" type="mesh" mesh="chassis_mesh" pos="0 0 0" material="car_body"/>
      
      <!-- Forward Camera -->
      <camera name="chaser_camera" pos="0.35 0 0.15" zaxis="1 0 0" fovy="91" resolution="800 600"/>

      <!-- Wheels -->
      <!-- Front Left -->
      <body name="fl_wheel" pos="0.25 0.3 -0.05">
        <joint name="fl_joint" type="hinge" axis="0 1 0"/>
        <geom name="fl_geom" type="cylinder" size="0.12 0.04" euler="90 0 0" material="car_wheel"/>
      </body>
      <!-- Back Left -->
      <body name="bl_wheel" pos="-0.25 0.3 -0.05">
        <joint name="bl_joint" type="hinge" axis="0 1 0"/>
        <geom name="bl_geom" type="cylinder" size="0.12 0.04" euler="90 0 0" material="car_wheel"/>
      </body>
      <!-- Front Right -->
      <body name="fr_wheel" pos="0.25 -0.3 -0.05">
        <joint name="fr_joint" type="hinge" axis="0 1 0"/>
        <geom name="fr_geom" type="cylinder" size="0.12 0.04" euler="90 0 0" material="car_wheel"/>
      </body>
      <!-- Back Right -->
      <body name="br_wheel" pos="-0.25 -0.3 -0.05">
        <joint name="br_joint" type="hinge" axis="0 1 0"/>
        <geom name="br_geom" type="cylinder" size="0.12 0.04" euler="90 0 0" material="car_wheel"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <velocity name="drive_fl" joint="fl_joint"/>
    <velocity name="drive_bl" joint="bl_joint"/>
    <velocity name="drive_fr" joint="fr_joint"/>
    <velocity name="drive_br" joint="br_joint"/>
  </actuator>
</mujoco>
